# Скопіюйте у .env і заповніть. Секрети в код і git не потрапляють (.env у .gitignore).
ALERTS_IN_UA_TOKEN=
TELEGRAM_BOT_TOKEN=
# Офіційне API: ключа немає й не буде (клас-заглушка UkraineAlarmSource)
UKRAINEALARM_API_KEY=
# alerts_in_ua | ukrainealarm
ALERT_SOURCE=alerts_in_ua
# Хмарна БД (Neon Postgres, адреса з -pooler). Якщо задано — воркер пише, бот читає звідси, а не з SQLite.
DATABASE_URL=
# Секрет webhook Telegram (>= 16 символів A-Za-z0-9_-): лишається у Vercel Environment Variables і тут
TELEGRAM_WEBHOOK_SECRET=
